# Shared configuration for docker-compose.yml.
# Docker Compose automatically reads this file and substitutes ${VAR} values below.

# --- PostgreSQL ---
# We run ONE Postgres container but create THREE separate databases inside it
# (orderdb, inventorydb, paymentdb) — see infra/postgres/init.sql.
# This still gives us "database per service": no service is allowed to
# connect to another service's database, they just happen to share a
# container to keep this learning setup lightweight.
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass
POSTGRES_DB=orderdb

# --- Payment Service ---
# Chance (0.0 - 1.0) that a simulated payment fails. Used to practice the
# Saga compensation flow (see MICROSERVICES_PRACTICE.md section 15).
PAYMENT_FAILURE_RATE=0.3
